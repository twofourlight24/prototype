--- !u!114 &1412148428
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1412148427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becbd94d80d63542b23c8482ae456b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fatherText: {fileID: 219644515}
  sonText: {fileID: 1332325471}
  endingText: {fileID: 513715165}
  typingSpeed: 0.05
  FadeImage: {fileID: 1176537900}
  skipButton: {fileID: 0}
  cutsceneImage: {fileID: 723397654}
  cutsceneSprites:
  - {fileID: -5859436265612616037, guid: dc63c0dca8a4bc6469743ed4c32a25d9, type: 3}
  - {fileID: -6568637135562972455, guid: a1db1230031e7f64583a55ae303a94f8, type: 3}
  cutsceneChangeIndices: 0000000005000000
  lines:
  - speaker: father
    text: "\uADF8\uB798\uC11C \uB9D0\uC774\uC57C, \uADF8 \uBC31\uD608\uAD6C\uB4E4\uC740
      \uB05D\uAE4C\uC9C0 \uC11C\uB85C\uB97C \uC9C0\uD0A4\uBA70 \uC2F8\uC6E0\uB2E8\uB2E4.
      \uADF8\uB9AC\uACE0 \uACB0\uAD6D, \uBAB8\uC18D\uC5D0\uC11C \uBAA8\uB4E0 \uC704\uD611\uC744
      \uBAB0\uC544\uB0C8\uC9C0."
  - speaker: son
    text: "\uC544\uBE60, \uADF8 \uBC31\uD608\uAD6C\uB4E4.. \uB0B4 \uBAB8\uC18D\uC5D0\uB3C4
      \uC788\uC744\uAE4C?"
  - speaker: father
    text: "\uADF8\uB7F4\uC9C0\uB3C4 \uBAA8\uB974\uC9C0. \uC9C0\uAE08\uB3C4 \uBAB8\uC18D\uC5D0\uC11C
      \uC5F4\uC2EC\uD788 \uC2F8\uC6B0\uACE0 \uC788\uC744 \uC218\uB3C4 \uC788\uACA0\uC9C0."
  - speaker: father
    text: "\uC774\uAC74 \uADF8\uB0E5 \uC774\uC57C\uAE30\uCC98\uB7FC \uB4E4\uB9B4\uC9C0
      \uBAB0\uB77C\uB3C4, \uC544\uBE60\uB294 \uADF8\uB4E4\uC774 \uC6B0\uB9AC\uC758
      \uC548\uC5D0 \uC788\uB2E4\uACE0 \uBBFF\uACE0 \uC788\uC5B4."
  - speaker: father
    text: "\uADF8\uB7EC\uB2C8\uAE4C, \uB10C \uC808\uB300 \uD63C\uC790\uAC00 \uC544\uB2C8\uC57C.
      \uC5B8\uC81C\uB098 \uB204\uAD70\uAC00\uAC00 \uB108\uB97C \uC9C0\uD0A4\uACE0
      \uC788\uB2E4\uB294 \uAC78 \uAE30\uC5B5\uD558\uB834."
  - speaker: ending
    text: "\uD50C\uB808\uC774\uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
