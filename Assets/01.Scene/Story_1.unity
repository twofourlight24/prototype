MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1412148427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becbd94d80d63542b23c8482ae456b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fatherText: {fileID: 219644515}
  sonText: {fileID: 1332325471}
  typingSpeed: 0.05
  FadeImage: {fileID: 1176537900}
  skipButton: {fileID: 601065735}
  cutsceneImage: {fileID: 723397654}
  cutsceneSprites:
  - {fileID: 7624880878084269611, guid: 2cc5cc2036cf7074296ba108ba87fb0a, type: 3}
  - {fileID: 9154448709329237222, guid: fe6e3e31fd47e67469ea9c308dd7cbbd, type: 3}
  - {fileID: -518169011970468496, guid: ac25f5b0d715c2541a1a9cc7729109b9, type: 3}
  cutsceneChangeIndices: 000000000200000006000000
  lines:
  - speaker: son
    text: "\uCF5C\uB85D\uCF5C\uB85D. \uC544\uBE60... \uB098 \uC5B4\uC9C0\uB7EC\uC6CC..."
  - speaker: father
    text: "\uC544\uB4E4, \uAD1C\uCC2E\uC744\uAC70\uC57C... \uC57D \uBA39\uC5C8\uC73C\uB2C8\uAE4C
      \uACE7 \uAD1C\uCC2E\uC544 \uC9C8\uAC70\uC57C"
  - speaker: son
    text: "\uB124.. \uC544\uBE60"
  - speaker: son
    text: "\uC544\uBE60... \uD639\uC2DC \uBD80\uD0C1 \uD558\uB098\uB9CC \uB4E4\uC5B4\uC8FC\uC2DC\uBA74
      \uC548\uB418\uC694?"
  - speaker: father
    text: "\uADF8\uB7FC~ \uC544\uB4E4\uC774 \uC6D0\uD558\uB294\uAC70 \uB2E4 \uB4E4\uC5B4\uC904\uAC8C
      \uC544\uBE60\uAC00"
  - speaker: son
    text: "\uC624\uB298\uB3C4 \uC7AC\uBC0C\uB294 \uC598\uAE30 \uD574\uC8FC\uC138\uC694"
  - speaker: father
    text: "\uADF8\uB798, \uC544\uBE60\uAC00 \uC624\uB298\uB3C4 \uC7AC\uBC0C\uB294
      \uC598\uAE30 \uD574\uC904\uAC8C"
  - speaker: father
    text: "...\uB450 \uBA85\uC758 \uC601\uC6C5\uC774 \uC788\uC5C8\uC5B4\uC694."
  - speaker: father
    text: "\uADF8 \uC601\uC6C5\uB4E4\uC740 \uC704\uD5D8\uD55C \uC138\uACC4\uB97C
      \uC9C0\uD0A4\uAE30 \uC704\uD574 \uC6A9\uC554\uB3D9\uAD74\uB85C \uB4E4\uC5B4\uAC14\uB2F5\uB2C8\uB2E4..."
